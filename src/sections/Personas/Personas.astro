---
import LanyardBadge from "../../components/ux/LanyardBadge/LanyardBadge.astro";
import personas from "../../data/personas.json";
import "./Personas.css";
import NoiseField from '../../components/ux/background/NoiseField.astro';

const imageUrls = import.meta.glob("../../assets/**/*", {
  eager: true,
  query: "?url",
  import: "default",
}) as Record<string, string>;

const resolveImage = (path?: string) => (path ? imageUrls[path] : undefined);
---
<section id="personas" class="personas-carousel" role="region" aria-labelledby="personas-title" aria-describedby="personas-subtitle" aria-roledescription="carousel" data-stagger-reveal>
  <h2 id="personas-title" class="personas-title" data-reveal-item>Nuestro Equipo</h2>
  <p id="personas-subtitle" class="personas-subtitle" data-reveal-item>
    Conoce al equipo detrás de cada experiencia.
  </p>
  <p class="personas-interaction-hint" data-reveal-item aria-hidden="true">
    Toca una tarjeta para descubrir su perfil
  </p>

  <NoiseField
    color="var(--palette-blue, #8e1a23)"
    background="var(--palette-night, #161516)"
    opacity={0.3}
    scale={1}
    animated={false}
    className="personas-noise"
  />
  <div class="personas-controls" role="group" aria-label="Controles de personas">
    <button type="button" class="personas-control" data-direction="previous" aria-label="Persona anterior" aria-controls="personas-track" disabled>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <button type="button" class="personas-control" data-direction="next" aria-label="Persona siguiente" aria-controls="personas-track">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </div>
  <div
    id="personas-track"
    class="personas-grid"
    data-personas-track
    data-lenis-prevent
    tabindex="0"
    role="group"
    aria-label="Credenciales"
    style={`--personas-count:${personas.length}`}
  >
  {personas.map((person, index) => {
    return (
      <div
        class:list={['personas-slide', index === 0 && 'is-active']}
          data-reveal-item
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} de ${personas.length}: ${person.name}`}
      >
        <LanyardBadge
          title={person.title}
          subtitle={person.subtitle}
          name={person.name}
          role={person.role}
          frontImage={resolveImage(person.LanyardBadgefront)}
          frontImageHover={resolveImage(person.LanyardBadgehover)}
          frontImageAlt={person.frontImageAlt}
          profileHref={`/personas/${person.slug}`}
          strapText="hola"
          strapLabel="PRODUCCIONES"
          strapColor="#06070a"
          inkColor="#000000"
          cardColor="#ffffff"
          cardWidth={240}
           height="clamp(32rem, 70svh, 48rem)"
          flipButton={false}
        />
      </div>
    );
  })}
  </div>
  <p class="personas-status" role="status" aria-live="polite"></p>
</section>
<script src="./Persona.ts"></script>
