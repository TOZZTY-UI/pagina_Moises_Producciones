---
import { getImage, Image } from 'astro:assets';
import BackGround from '../../assets/hero.png';
import MobileBackground from '../../assets/heroMovil.png';
import TabletBackground from '../../assets/heroTablet.png';
import Button from '../../components/ux/Button/Button.astro';

import '../../components/ux/Button/button.css';
import './Hero.css';

const mobileHeroImage = await getImage({
  src: MobileBackground,
  width: 960,
  format: 'webp',
});

const tabletHeroImage = await getImage({
  src: TabletBackground,
  width: 1600,
  format: 'webp',
});
---

<section
  id="inicio"
  class="hero"
  data-hero-intro
  aria-labelledby="hero-title"
>
  <!-- IMAGEN Y MÁSCARA DE REVELADO -->
  <div class="hero__image-mask">
    <picture class="hero__picture">
      <source
        media="(max-width: 600px)"
        srcset={mobileHeroImage.src}
      />
      <source
        media="(min-width: 601px) and (max-width: 1100px)"
        srcset={tabletHeroImage.src}
      />
      <Image
        class="hero__image"
        src={BackGround}
        alt=""
        widths={[640, 960, 1280, 1680]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <span class="hero__camera-exposure" aria-hidden="true"></span>
  </div>

  <!-- DEGRADADO -->
  <div
    class="hero__scrim"
    aria-hidden="true"
  ></div>
  <span class="hero__camera-flash" aria-hidden="true"></span>

  <!-- DESTELLO DIAGONAL -->
  <div
    class="hero__sheen"
    aria-hidden="true"
  ></div>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="hero__content">
    <div class="hero__title-wrap">
        <h1 id="hero-title">Música para tus momentos</h1>
        <p>SaxEventos Producciones</p>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="hero__footer">
    <p class="hero__description">
      Música en vivo y fotografía para bodas, celebraciones y eventos corporativos.
    </p>

    <Button
      href="https://wa.me/56949251898?text=Hola%20SaxEventos%2C%20quiero%20cotizar%20un%20evento."
      text="Cotizar por WhatsApp"
      className="hero__cta"
      aria-label="Cotizar un evento por WhatsApp"
      target="_blank"
      rel="noopener noreferrer"
    />
    <a class="hero__secondary-cta" href="#servicios">Ver qué hacemos</a>
  </div>
</section>

<script src="./Hero.ts"></script>

<noscript>
  <style>
    .hero[data-hero-intro] .hero__image-mask {
      clip-path: none;
    }
  </style>
</noscript>
