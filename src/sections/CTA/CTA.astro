---
import './CTA.css';

const whatsappUrl =
  'https://wa.me/56949251898?text=Hola%20SaxEventos%2C%20quiero%20conversar%20sobre%20mi%20evento.';
---

<section class="conversion-cta" aria-labelledby="conversion-cta-title">
  <div>
    <h2 id="conversion-cta-title">¿Ya tienes una fecha?</h2>
    <p>Cuéntanos qué estás preparando y encontremos la forma de hacerlo inolvidable.</p>
  </div>
  <a class="conversion-cta__button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a>
</section>
