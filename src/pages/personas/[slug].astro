---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base/Base.astro';
import personas from '../../data/personas.json';

export const getStaticPaths = (() =>
  personas.map((persona) => ({
    params: { slug: persona.slug },
    props: { persona },
  }))) satisfies GetStaticPaths;

const { persona } = Astro.props;
---

<Base title={`${persona.name} | Moisés Producciones`} showPreloader={false}>
  <main class="person-page">
    <a class="back-link" href="/">← Volver al inicio</a>
    <p class="eyebrow">{persona.title}</p>
    <h1>{persona.name}</h1>
    <p class="role">{persona.role}</p>
    <p class="description">{persona.description}</p>
  </main>

</Base>

<style>
  .person-page {
    min-height: 78svh;
    padding: clamp(8rem, 16vw, 13rem) clamp(1.5rem, 8vw, 8rem) 5rem;
    color: #e8dfcc;
  }

  .back-link {
    display: inline-block;
    margin-bottom: clamp(4rem, 10vw, 8rem);
    color: #b59a6c;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: #b59a6c;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 56rem;
    margin: 0;
    font-size: clamp(3.5rem, 11vw, 9rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .role {
    margin: 3rem 0 1rem;
    font-size: clamp(1.25rem, 2.5vw, 2rem);
  }

  .description {
    max-width: 38rem;
    color: rgb(232 223 204 / 0.68);
    line-height: 1.6;
  }
</style>
