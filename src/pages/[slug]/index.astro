---
import type { GetStaticPaths } from 'astro';
import LandingPage from '../../layouts/Landing/LandingPage.astro';
import personas from '../../data/personas.json';
import Blob from '../../components/ux/blob/blob.astro';
import './index.css';

const profileImages = import.meta.glob('../../assets/**/*.{webp,jpg,jpeg,png}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;

const resolveProfileImage = (path?: string) => (
  path ? profileImages[path] : undefined
);

export const getStaticPaths = (() =>
  personas.map((persona) => ({
    params: { slug: persona.slug },
    props: { persona },
  }))) satisfies GetStaticPaths;

const { persona } = Astro.props;
---

<LandingPage
  title={`${persona.name} | Moisés Producciones`}
  showPreloader={false}
  personPage
  navColor={persona.foreground}
  navMuted={persona.mutedForeground}
>
    <main
      class="person-page"
      data-person-page
      data-stagger-reveal
      style={`--person-bg:${persona.background};--person-ink:${persona.foreground};--person-muted:${persona.mutedForeground}`}
    >
    <div class="person-page__layout">
      <div class="person-page__copy" data-reveal-item>
        <a class="back-link" href="/" data-person-back>← Volver al inicio</a>
        <p class="person-label">{persona.title}</p>
        <h1>{persona.name}</h1>
        <p class="role">{persona.role}</p>
        <p class="description">{persona.description}</p>
      </div>
      <div data-reveal-item>
        <Blob
          image={resolveProfileImage(persona.profileImage)}
          alt={persona.frontImageAlt}
          imagePosition={persona.profileImagePosition}
        />
      </div>
    </div>
  </main>
</LandingPage>

<script src="../../scripts/person-page.ts"></script>
