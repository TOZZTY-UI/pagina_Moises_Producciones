---
import './NoiseField.css';

interface Props {
  color?: string;
  background?: string;
  opacity?: number;
  scale?: number;
  speed?: number;
  animated?: boolean;
  className?: string;
}

const {
  color = '#8f73ff',
  background = '#0b0b0f',
  opacity = 0.3,
  scale = 1,
  speed = 6,
  animated = true,
  className = '',
} = Astro.props;
---

<div
  class:list={['fb-noise-field', className]}
  style={`--noise-background:${background};--noise-color:${color};--noise-opacity:${opacity};--noise-scale:${scale};--noise-speed:${speed}s`}
  aria-hidden="true"
>
  <div class:list={['fb-noise-field__blob', 'fb-noise-field__blob--one', { 'fb-noise-field__blob--animated': animated }]}></div>
  <div class:list={['fb-noise-field__blob', 'fb-noise-field__blob--two', { 'fb-noise-field__blob--animated': animated }]}></div>
  <div class:list={['fb-noise-field__texture', { 'fb-noise-field__texture--animated': animated }]}></div>
</div>
