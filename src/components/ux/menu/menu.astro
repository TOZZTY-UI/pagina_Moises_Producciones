
---
import { navigation } from '../../../lib/navigation';
import { ResponsiveNavbar } from './navigation-menu';

interface NavItem {
  name: string;
  href: string;
  sectionId?: string;
}

export interface Props {
  items?: NavItem[];
  compact?: boolean;
}

const {
  compact = false,
  items = navigation.map(({ label, href, sectionId }) => ({ name: label, href, sectionId })),
} = Astro.props;

const menuItems = compact
  ? [{ name: "Inicio", href: "/" }]
  : [
      ...items,
      ...(items.some((item) => item.href === "/contacto")
        ? []
        : [{ name: "Contacto", href: "/contacto" }]),
    ];

const visibleItems = compact
  ? menuItems.filter((item) => !item.sectionId)
  : menuItems;
---

<ResponsiveNavbar
  client:load
  items={visibleItems}
  compact={compact}
/>
