---
---
<div id="preloader" role="status" aria-label="Cargando página">
  <div class="loader-content">
    <span class="dot"></span>
    <span id="loader-word">Hola</span>
  </div>

  <svg class="loader-curve" viewBox="0 0 100 100"
       preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0 H100 Q50 180 0 0 Z" />
  </svg>
</div>

<div class="loader-orbs" aria-hidden="true">
  <span class="loader-orb loader-orb--pink"></span>
  <span class="loader-orb loader-orb--yellow"></span>
  <span class="loader-orb loader-orb--blue"></span>
</div>

<script src="./Preloader.js"></script>
<style>@import './Preloader.css';</style>