---
import socialLinks from "../../../data/socialLinks.json";
interface Link {
  label: string;
  href?: string;
}
interface Column {
  title: string;
  links: Link[];
}
interface Action extends Link {
  variant?: "solid" | "outline";
}
interface Props {
  wordmark?: string;
  brand?: string;
  columns?: Column[];
  actions?: Action[];
  copyright?: string;
  backToTop?: boolean;
}

const {
  wordmark = "SAXEVENTOS PRODUCCIONES",
  copyright = "©" + new Date().getFullYear() + " saxeventos producciones.",
  backToTop = true,
} = Astro.props;

const doodles = ["♪", "♫", "♩", "♬", "♪", "♫", "♩", "♬"];

---

<footer id="contacto" class="dcf" data-footer data-stagger-reveal>
  <div class="dcf-world">
    <div class="dcf-stage">
      <div class="dcf-doodles" aria-hidden="true">
        {
          doodles.map((doodle, i) => (
            <span style={`--x:${5 + i * 12}%;--delay:${i * -0.8}s`}>
              {doodle}
            </span>
          ))
        }
      </div>
      <h2 class="dcf-wordmark" aria-label={wordmark} data-reveal-item>
        {
          wordmark
            .toUpperCase()
            .split(/\s+/)
            .map((word, wordIndex) => (
              <span class="dcf-wordmark__line" aria-hidden="true">
                {Array.from(word).map((letter, letterIndex) => (
                  <span class="dcf-wordmark__letter" style={`--i:${wordIndex * 20 + letterIndex}`}>
                    {letter}
                  </span>
                ))}
              </span>
            ))
        }
      </h2>
      
      <div class="dcf-bubble" role="status" aria-live="polite" hidden></div>
    </div>
    
  </div>
  <br />
  <div class="dcf-bar" data-reveal-item>
    <p>{copyright}</p>
    {
      socialLinks.length > 0 && (
        <ul class="dcf-bar__social" aria-label="Social media">
          {socialLinks.map((link) => (
            <li>
              <a href={link.url} aria-label={link.name} title={link.name}>
                <span class="social-icon" set:html={link.icon} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      backToTop && (
<button>
  <div class="text">
    <span>Back</span>
    <span>to</span>
    <span>top</span>
  </div>
  <div class="clone">
    <span>Back</span>
    <span>to</span>
    <span>top</span>
  </div>
  <svg
    stroke-width="2"
    stroke="currentColor"
    viewBox="0 0 24 24"
    fill="none"
    class="h-6 w-6"
    xmlns="http://www.w3.org/2000/svg"
    width="20px"
  >
    <path
      d="M14 5l7 7m0 0l-7 7m7-7H3"
      stroke-linejoin="round"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

      )
    }
  </div>
</footer>

<script src="./Footer.ts"></script>

<style>@import "./Footer.css";

button {
  width: 140px;
  height: 56px;
  overflow: hidden;
  border: none;
  color: #000000;
  background: none;
  position: relative;
  padding-bottom: 2em;
  cursor: pointer;
}

button > div,
button > svg {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
}

button:before {
  content: "";
  position: absolute;
  height: 2px;
  bottom: 0;
  left: 0;
  width: 100%;
  transform: scaleX(0);
  transform-origin: bottom right;
  background: currentColor;
  transition: transform 0.25s ease-out;
}

button:hover:before {
  transform: scaleX(1);
  transform-origin: bottom left;
}

button .clone > *,
button .text > * {
  opacity: 1;
  font-size: 1.3rem;
  transition: 0.2s;
  margin-left: 4px;
}

button .clone > * {
  transform: translateY(60px);
}

button:hover .clone > * {
  opacity: 1;
  transform: translateY(0px);
  transition: all 0.2s cubic-bezier(0.215, 0.61, 0.355, 1) 0s;
}

button:hover .text > * {
  opacity: 1;
  transform: translateY(-60px);
  transition: all 0.2s cubic-bezier(0.215, 0.61, 0.355, 1) 0s;
}

button:hover .clone > :nth-child(1) {
  transition-delay: 0.15s;
}

button:hover .clone > :nth-child(2) {
  transition-delay: 0.2s;
}

button:hover .clone > :nth-child(3) {
  transition-delay: 0.25s;
}

button:hover .clone > :nth-child(4) {
  transition-delay: 0.3s;
}
/* icon style and hover */
button svg {
  width: 20px;
  right: 0;
  top: 50%;
  transform: translateY(-50%) rotate(-50deg);
  transition: 0.2s ease-out;
}

button:hover svg {
  transform: translateY(-50%) rotate(-90deg);
}

</style>
