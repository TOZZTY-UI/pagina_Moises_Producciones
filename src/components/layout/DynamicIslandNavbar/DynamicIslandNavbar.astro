---
import { navigation } from '../../../data/navigation';
const menuLinks = navigation.filter((link) => link.showInSidebar);
---

<nav class="island-nav" aria-label="Navegación principal" data-island-nav>
  <div class="island-nav__shell">
    <button
      class="island-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="island-menu"
      aria-label="Abrir navegación"
      data-island-toggle
    >
      <span class="island-nav__toggle-line"></span>
      <span class="island-nav__toggle-line"></span>
    </button>

    <div class="island-nav__menu" id="island-menu" data-island-menu>
      <div class="island-nav__links">
        {menuLinks.map((link) => (
          <a href={link.href} class="island-nav__link" data-nav-link data-section={link.id}>
            <span>{link.label}</span>
            <span class="island-nav__link-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script src="./dynamic-island-navbar.ts"></script>

<style>
  @import 'dynamic-island-navbar.css';
</style>
